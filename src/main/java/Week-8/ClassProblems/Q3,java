abstract class Question {
    String question;
    String correctAnswer;
    int marks;

    Question(String question, String correctAnswer, int marks) {
        this.question = question;
        this.correctAnswer = correctAnswer;
        this.marks = marks;
    }

    abstract boolean checkAnswer(String answer);
}

class MCQ extends Question {

    MCQ(String question, String correctAnswer, int marks) {
        super(question, correctAnswer, marks);
    }

    boolean checkAnswer(String answer) {
        return answer.equals(correctAnswer);
    }
}

class TrueFalse extends Question {

    TrueFalse(String question, String correctAnswer, int marks) {
        super(question, correctAnswer, marks);
    }

    boolean checkAnswer(String answer) {
        return answer.equals(correctAnswer);
    }
}

class Student {
    String name;

    Student(String name) {
        this.name = name;
    }
}

class Attempt {
    Student student;
    boolean submitted = false;
    int score = 0;

    Attempt(Student student) {
        this.student = student;
    }

    void answer(Question q, String answer) {
        if (!submitted) {
            if (q.checkAnswer(answer)) {
                score += q.marks;
                System.out.println("Answer recorded: Correct");
            } else {
                System.out.println("Answer recorded: Incorrect");
            }
        } else {
            System.out.println("Cannot change answers for a submitted examination.");
        }
    }

    void submit() {
        submitted = true;
        System.out.println("Exam submitted by " + student.name);
        System.out.println("Total score: " + score);
    }
}

public class Q3 {
    public static void main(String[] args) {

        Student s = new Student("Student 1");

        Question q1 = new MCQ(
                "Which is an OOP concept?",
                "C",
                5);

        Question q2 = new TrueFalse(
                "Java supports inheritance.",
                "True",
                5);

        Attempt a = new Attempt(s);

        System.out.println("Exam started by " + s.name);

        a.answer(q1, "C");
        a.answer(q2, "False");

        a.submit();

        a.answer(q1, "B");
    }
}